# Optional project .env (takes priority when a value is set).
# If a key is missing/empty here, the app falls back to:
#   Windows: C:\Users\<you>\ge.txt
#   Same KEY=value format as this file.

# GitLab (SSP)
GITLAB_TOKEN=
GITLAB_DEFAULT_AUTHOR=

# GitHub
GITHUB_TOKEN=
GITHUB_DEFAULT_AUTHOR=

# Diff report defaults (gitlab | github)
DIFF_DEFAULT_PLATFORM=gitlab

# AI
CLAUDE_KEY=

# Redmine version anchors (optional)
# STARTING_VERSAO=489
# STARTING_DATE=2025-01-01

# SSP task form defaults (optional)
# RD_DEFAULT_SISTEMA=SICOR
# RD_DEFAULT_ORGAO=PM
# RD_DEFAULT_ATRIBUICAO=Desenvolvedor Sênior
# RD_DEFAULT_PROJETO=SICOR
# RD_DEFAULT_DESENVOLVEDOR=142
# RD_MIN_TASK_HOURS=8
